* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.pdf binary
*.docx binary
*.pptx binary
*.xlsx binary
*.wasm binary

# Preserve byte-level provenance and frozen review/manifest checksums on checkout.
datasets/** -text whitespace=cr-at-eol,-blank-at-eof
results/furniture_day1/data_audit/** -text whitespace=cr-at-eol
