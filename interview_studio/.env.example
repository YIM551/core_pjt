DATABASE_URL=postgresql+psycopg://careerfit:careerfit@db:5432/careerfit
SESSION_SECRET=change-me-for-local-development
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_API_KEY=local-key
LLM_MODEL=qwen-model
LLM_TIMEOUT_SECONDS=60
EMBEDDING_BASE_URL=http://host.docker.internal:8081/v1
